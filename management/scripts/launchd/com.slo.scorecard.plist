<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.slo.scorecard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/john.blythe/code/management/scripts/cron-slo-scorecard.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <!-- Monday 9am — start of week scorecard refresh -->
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/slo-scorecard.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/slo-scorecard.err</string>
</dict>
</plist>
