# Create GitHub issue in ideas repo
idea() {
  if [ -z "$1" ]; then
    echo "Usage: idea \"your idea title\" [body]"
    echo "       idea -l  # list recent ideas"
    return 1
  fi

  if [ "$1" = "-l" ]; then
    gh issue list -R johnblythe/ideas --limit 10
    return 0
  fi

  local title="$1"
  local body="${2:-}"

  gh issue create -R johnblythe/ideas --title "$title" --body "$body"
}

