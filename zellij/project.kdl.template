// Project Config Template
// Usage: Copy to ~/.config/zellij/<project>.kdl and replace {{PROJECT}} and {{PROJECT_PATH}}
theme "tokyo-night"

themes {
    tokyo-night {
        fg "#c0caf5"
        bg "#1a1b26"
        black "#15161e"
        red "#f7768e"
        green "#9ece6a"
        yellow "#e0af68"
        blue "#7aa2f7"
        magenta "#bb9af7"
        cyan "#7dcfff"
        white "#a9b1d6"
        orange "#ff9e64"
    }
}

ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

session_name "{{PROJECT}}"
default_mode "normal"
default_layout "{{PROJECT}}"
